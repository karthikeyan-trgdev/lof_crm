{
  "name": "lof-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Lab of Future CRM – Cloudflare Workers + D1 API, integrations and testing module",
  "type": "module",
  "scripts": {
    "build:frontend": "node scripts/patch-frontend.mjs",
    "build:seed": "node scripts/build-seed.mjs",
    "build": "npm run build:frontend && npm run build:seed",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply lof_crm --local",
    "db:migrate:remote": "wrangler d1 migrations apply lof_crm --remote",
    "deploy": "npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.149.0"
  }
}
